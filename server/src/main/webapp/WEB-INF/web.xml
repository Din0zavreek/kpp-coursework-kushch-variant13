<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="4.0">

    <display-name>Hotel Requests Server</display-name>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>RoomServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.Servlet.RoomServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RoomServlet</servlet-name>
        <url-pattern>/rooms</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SpecialistServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.Servlet.SpecialistServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SpecialistServlet</servlet-name>
        <url-pattern>/specialists</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RequestServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.Servlet.RequestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RequestServlet</servlet-name>
        <url-pattern>/requests</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ExecutionRecordServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.Servlet.ExecutionRecordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ExecutionRecordServlet</servlet-name>
        <url-pattern>/execution-records</url-pattern>
    </servlet-mapping>

</web-app>